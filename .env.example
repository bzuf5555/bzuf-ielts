# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Groq API Key (FREE at console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# MongoDB Atlas URI (FREE at mongodb.com/atlas)
# Format: mongodb+srv://username:password@cluster.mongodb.net/bzuf_ielts?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/bzuf_ielts

# Render deployment URL (set this after deploying to Render)
# Example: https://bzuf-ielts.onrender.com
RENDER_EXTERNAL_URL=https://your-app.onrender.com

# Port (Render sets this automatically)
PORT=8000

# Environment: "development" uses polling, "production" uses webhook
ENVIRONMENT=development

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
